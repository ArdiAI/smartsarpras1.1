# Smart Sarpras - contoh environment PostgreSQL sekolah
# Jangan commit password/secret asli.

NODE_ENV=production
PORT=3001

# Frontend mengarah ke backend Node/Express.
VITE_API_URL=http://localhost:3001

# PostgreSQL sekolah
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=smart_sarpras
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true

# Session auth lokal
SESSION_TTL_DAYS=7
APP_PUBLIC_URL=https://sarpras.smkn1-cmi.sch.id

# Origin frontend production
ALLOWED_ORIGINS=https://sarpras.smkn1-cmi.sch.id

# Google Drive Apps Script
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_TOKEN=

# SMTP reset password/notifikasi
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=Smart Sarpras
