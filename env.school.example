# Smart Sarpras - contoh environment PostgreSQL sekolah
# Jangan commit password/secret asli.

NODE_ENV=production
PORT=3001

# Frontend mengarah ke backend Node/Express.
VITE_API_URL=http://localhost:3001

# PostgreSQL sekolah
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=smart_sarpras
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true

# Session auth lokal
SESSION_TTL_DAYS=7
APP_PUBLIC_URL=https://sarpras.smkn1-cmi.sch.id

# Origin frontend production
ALLOWED_ORIGINS=https://sarpras.smkn1-cmi.sch.id

# Google Drive Apps Script
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_TOKEN=

# SMTP reset password/notifikasi
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=Smart Sarpras


# =====================================================
# ONE-TIME FULL DATA SYNC
# Sumber = database operasional terbaru.
# Gunakan salah satu: SOURCE_DATABASE_URL atau SOURCE_PG*.
# Jangan commit password/database URL asli.
# =====================================================
SOURCE_DATABASE_URL=
SOURCE_PGHOST=
SOURCE_PGPORT=5432
SOURCE_PGUSER=
SOURCE_PGPASSWORD=
SOURCE_PGDATABASE=
SOURCE_PGSSL=true
SOURCE_PGSSL_REJECT_UNAUTHORIZED=true

# Wajib YES hanya saat benar-benar menjalankan mirror.
CONFIRM_FULL_DATA_SYNC=NO

# Optional. Default 100; rentang aman 25-500.
SYNC_BATCH_SIZE=100

# Untuk cek saja tanpa mengubah database tujuan.
SYNC_DRY_RUN=NO

# Jika pg_dump PostgreSQL tidak ada di PATH, isi path executable.
# Contoh Windows:
# PG_DUMP_BIN=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
PG_DUMP_BIN=


# Jalur cepat sync agenda + kavling via Supabase REST
# Jika .env lama masih punya VITE_SUPABASE_ANON_KEY, variabel ini boleh dikosongkan.
SOURCE_SUPABASE_URL=https://nhpwomtzjxejihenglpb.supabase.co
SOURCE_SUPABASE_KEY=
