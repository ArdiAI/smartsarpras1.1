# ============================================
# SMART SARPRAS - CONTOH ENVIRONMENT VARIABLES
# JANGAN isi file ini dengan secret asli.
# Salin menjadi .env di server/lokal, lalu isi nilainya.
# ============================================

NODE_ENV=development
PORT=3001

# Frontend -> backend API
VITE_API_URL=http://localhost:3001

# Supabase Auth (frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Auth (backend)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# PostgreSQL / Supabase Postgres
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# Production Supabase/Postgres:
# set true jika koneksi production memakai SSL.
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true

# Tambahan origin frontend production, pisahkan dengan koma.
# Contoh:
# ALLOWED_ORIGINS=https://sarpras.smkn1-cmi.sch.id,https://sarpras-backup.example.sch.id
ALLOWED_ORIGINS=

# Google Drive Apps Script
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_TOKEN=

# Optional: lokasi binary PostgreSQL jika tidak ada di PATH
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
